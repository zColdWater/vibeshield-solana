  "bin": {
    "vibeshield-solana": "./bin/vibeshield-solana.mjs"
  },
  "main": "./src/scanner.mjs",
  "exports": {
    ".": "./src/scanner.mjs"
  },
  "scripts": {
    "test": "node --test test/smoke.test.mjs",
    "scan:pyusd": "node bin/vibeshield-solana.mjs 2b1kV6DkPAnxd5ixfnxCpjxmKwqjjaYmCZfHsFu24GXo",
    "scan:jup": "node bin/vibeshield-solana.mjs JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4"
  },
  "keywords": [
    "solana",
